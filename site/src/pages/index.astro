---
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import { example } from '../data/site';
import { url } from '../data/url';
import s1 from '../data/sim/s1.json';
const pct = (v: number) => `${Math.round(v * 100)}%`;
const full = s1.res.full.first[0], nearest = s1.res.nearest.first[0];
// hero: one evening on a sketch of the Chennai coast. Three ideas leave home; two fail a fence; one becomes the route.
const loop = 'M64 330 C 80 240, 118 158, 176 150 C 232 142, 272 192, 250 244 C 232 292, 150 336, 64 330';
---
<Base slug="" title="The product in one minute">
  <section class="door hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="chapter" data-reveal="fade" data-intro>01 · The product in one minute</p>
        <h1 class="display" data-split="lines" data-intro>“I’m bored.” Three ideas, <span class="t-turmeric">checked.</span></h1>
        <p class="lede muted" data-reveal="up" data-intro data-delay="0.35">An app that knows you and knows Chennai. You say what you feel like in one sentence. It plans the evening, proves every fact, and remembers how it went.</p>
        <div class="hero__cta" data-reveal="up" data-intro data-delay="0.5">
          <a class="btn btn--fill" href={url('how-it-works/')}><span class="roll"><span>See how it works</span><span aria-hidden="true">See how it works</span></span></a>
          <a class="btn" href={url('goals/')}><span class="roll"><span>Goals and scope</span><span aria-hidden="true">Goals and scope</span></span></a>
        </div>
      </div>
      <svg class="hero__route" viewBox="0 0 360 400" data-hero-route role="img" aria-label="A sketch of the Chennai coast. From home, three ideas go out. The rooftop grill fails the budget and the beach shack has no veg menu. The third becomes the route: Kaveri thali at 7:30, Malli dessert at 9:05, home by 9:40.">
        <defs>
          <radialGradient id="hero-fade" cx="45%" cy="55%" r="65%"><stop offset="0.55" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
          <mask id="hero-mask"><rect width="360" height="400" fill="url(#hero-fade)" /></mask>
        </defs>
        <g class="map" data-map mask="url(#hero-mask)">
          <path class="road" d="M0 70 L330 44 M0 212 L330 190 M0 372 L330 352 M44 0 L62 400 M150 0 L160 400 M244 0 L262 400" />
          <path class="sea" d="M334 0 C 322 60, 344 122, 330 182 S 342 300, 326 400 L360 400 L360 0 Z" />
          <path class="coast" d="M334 0 C 322 60, 344 122, 330 182 S 342 300, 326 400" />
          </g>
        <g class="map" data-map>
          <text class="sea-label" transform="translate(350 120) rotate(90)">Bay of Bengal</text>
        </g>
        <g class="cand fail" data-cand>
          <path d="M64 330 C 56 236, 66 150, 96 96" data-cand-line />
          <g class="x" data-x transform="translate(96 96)"><path d="M-5 -5 L5 5 M5 -5 L-5 5" /></g>
          <text x="84" y="80" class="name" text-anchor="end">Rooftop grill</text>
          <text x="84" y="95" class="why" text-anchor="end" data-why>₹1,400 each</text>
        </g>
        <g class="cand fail" data-cand>
          <path d="M64 330 C 150 362, 236 352, 286 326" data-cand-line />
          <g class="x" data-x transform="translate(286 326)"><path d="M-5 -5 L5 5 M5 -5 L-5 5" /></g>
          <text x="300" y="356" class="name" text-anchor="end">Beach shack</text>
          <text x="300" y="371" class="why" text-anchor="end" data-why>no veg menu</text>
        </g>
        <path class="route" d={loop} data-route />
        <g class="stop" data-stop transform="translate(176 150)"><circle r="7" /></g>
        <g class="stop" data-stop transform="translate(250 244)"><circle r="7" /></g>
        <g class="labels" data-labels>
          <text x="186" y="122" class="name">Kaveri thali</text>
          <text x="186" y="137" class="time">7:30 dinner</text>
          <text x="238" y="230" class="name" text-anchor="end">Malli dessert</text>
          <text x="238" y="245" class="time" text-anchor="end">9:05 sweet</text>
        </g>
        <g class="home" transform="translate(64 330)"><circle r="9" class="ring" /><circle r="3.5" /></g>
        <text x="40" y="364" class="name">Home</text>
        <text x="40" y="379" class="time">leave 7:15 · back 9:40</text>
        <circle r="4" class="you" data-you cx="64" cy="330" />
      </svg>
    </div>
  </section>

  <section class="wrap row airy">
    <p class="chapter">What it is</p>
    <div class="prose">
      <p class="h2">A cousin who knows you, knows the city, and always has a good idea.</p>
      <p>Most apps start by asking <em>what</em> you want: a category, a place, a distance. This one starts from who you are and what tonight is like. You can be as vague as “I’m bored” or as specific as a plan with a deadline. It answers with two or three ideas, each with a reason, and changes the plan the moment you change your mind.</p>
    </div>
  </section>

  <section class="wrap row">
    <p class="chapter">The example on every page</p>
    <div class="example">
      <p class="said">{example.said}</p>
      <div class="reply">
        <p class="muted small">The cousin replies</p>
        <p><b>Kaveri thali place</b>, 7:30 pm. About ₹420 each, 12 min away, veg menu confirmed.</p>
        <p><b>Malli dessert corner</b>, 9:05 pm. On your way home, about ₹90 each.</p>
        <p class="muted">Home by 9:40 pm. Want somewhere livelier instead?</p>
      </div>
      <div class="pieces" aria-label="How the request is understood">
        {example.pieces.map((p) => <span class={`piece ${p.kind}`}><b>{p.kind === 'find' ? 'FIND' : p.kind === 'fence' ? 'MUST' : 'LIKES'}</b>{p.text}</span>)}
      </div>
      <p class="muted small">This one evening runs through the whole site. Each page shows what its algorithm does to it. Places, prices and times are invented.</p>
    </div>
  </section>

  <section class="wrap row">
    <p class="chapter">Why it’s different</p>
    <div class="diff">
      <div><b>Google Maps</b><p>Answers a search. It waits until you know what you want.</p></div>
      <div><b>District and booking apps</b><p>Sell a table or a ticket once you’ve decided.</p></div>
      <div class="us"><b>The Cousin</b><p>Starts before the search, when all you have is “I’m bored”. Plans across places, experiences, clubs and events, for you, tonight.</p></div>
    </div>
  </section>

  <section class="door">
    <div class="wrap row airy">
      <p class="chapter">Where we are</p>
      <div class="where">
        <div class="facts">
          <div class="fact"><b>{pct(full)}</b><span>first replies accepted by the full design, in a simulation with 50 synthetic people</span></div>
          <div class="fact"><b>{pct(nearest)}</b><span>for a simple “nearest open place” app, same people, same situations</span></div>
        </div>
        <p class="lede">Planning is done and the engine has been tested in simulation. No product code exists yet. The simulated people are made up, so these numbers rank ideas against each other; real friends have to confirm them.</p>
        <div class="legend">
          <p class="muted small">Every part of this site carries one of three labels:</p>
          <div class="legend__row"><Status s="tested" /><Status s="designed" /><Status s="open" /></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: calc(var(--u) * 4) calc(var(--u) * 4.5); overflow: clip; }
  .hero__grid { display: grid; gap: calc(var(--u) * 4); align-items: center; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .hero__text { display: grid; gap: calc(var(--u) * 2.2); }
  .hero__text .lede { max-width: 40ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.6rem; }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 1.3rem; border-radius: 99px; border: 1px solid var(--c-door-line); font-weight: 600; transition: background 0.4s, color 0.4s, border-color 0.4s; }
  .btn:hover { border-color: var(--c-rice); }
  .btn--fill { background: var(--c-turmeric); color: var(--c-door); border-color: var(--c-turmeric); }
  .btn--fill:hover { background: var(--c-rice); border-color: var(--c-rice); }
  .hero__route { width: min(100%, 27rem); justify-self: end; overflow: visible; }
  @media (max-width: 899px) { .hero__route { width: min(100%, 24rem); justify-self: start; } }
  .hero__route .road { fill: none; stroke: var(--c-rice); stroke-opacity: 0.07; stroke-width: 1; }
  .hero__route .sea { fill: var(--c-rice); fill-opacity: 0.04; }
  .hero__route .coast { fill: none; stroke: var(--c-rice); stroke-opacity: 0.35; stroke-width: 1.2; }
  .hero__route text { font-family: var(--f-body); font-size: 12.5px; fill: var(--c-rice); }
  .hero__route .sea-label { font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.12em; fill: var(--c-door-muted); }
  .hero__route .name { font-weight: 600; }
  .hero__route .time { font-family: var(--f-mono); font-size: 10px; fill: var(--c-turmeric); }
  .hero__route .why { font-family: var(--f-mono); font-size: 10px; fill: var(--c-kumkum); }
  .hero__route .cand path { fill: none; stroke: var(--c-rice); stroke-opacity: 0.32; stroke-width: 1.4; stroke-dasharray: 3 5; stroke-linecap: round; }
  .hero__route .cand .x path { stroke: var(--c-kumkum); stroke-opacity: 1; stroke-width: 2.2; stroke-dasharray: none; }
  .hero__route .cand .name { fill: var(--c-door-muted); text-decoration: line-through; }
  .hero__route .route { fill: none; stroke: var(--c-turmeric); stroke-width: 3; stroke-linecap: round; }
  .hero__route .stop circle { fill: var(--c-door); stroke: var(--c-turmeric); stroke-width: 3; }
  .hero__route .home circle { fill: var(--c-rice); }
  .hero__route .home .ring { fill: none; stroke: var(--c-rice); stroke-width: 1.5; }
  .hero__route .you { fill: var(--c-rice); opacity: 0; }
  .small { font-size: 0.92rem; }
  .example { display: grid; gap: 1.1rem; max-width: 42rem; }
  .reply { justify-self: start; background: var(--c-card); border: 1px solid var(--c-line); border-left: 3px solid var(--c-turmeric); border-radius: 4px 18px 18px 18px; padding: 1rem 1.2rem; display: grid; gap: 0.35rem; max-width: 34rem; }
  .diff { display: grid; gap: 0; }
  .diff > div { display: grid; gap: 0.3rem 2rem; padding: 1.1rem 0; border-top: 1px solid var(--c-line); }
  @media (min-width: 700px) { .diff > div { grid-template-columns: 16rem 1fr; } }
  .diff b { font-size: var(--t-m); font-weight: 700; letter-spacing: -0.015em; }
  .diff .us b { color: var(--c-turmeric-ink); }
  .diff p { max-width: 52ch; }
  .where { display: grid; gap: calc(var(--u) * 3); }
  .where .lede { max-width: 52ch; }
  .legend { display: grid; gap: 0.6rem; }
  .legend__row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
</style>
