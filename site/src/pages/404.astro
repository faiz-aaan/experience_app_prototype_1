---
import Base from '../layouts/Base.astro';
import { url } from '../data/url';
---
<Base slug="404" title="Not on the map">
  <section class="door lost">
    <div class="wrap lost__grid">
      <div class="lost__text">
        <p class="chapter">404 · Not on the map</p>
        <h1 class="h1">This route ends nowhere.</h1>
        <p class="lede muted">The page you asked for isn’t here. A cousin would never leave it at that, so here are the nearest real places.</p>
        <div class="lost__cta">
          <a class="btn btn--fill" href={url('')}><span class="roll" data-t="The product in one minute"><span>The product in one minute</span></span></a>
          <a class="btn" href={url('how-it-works/')}><span class="roll" data-t="How it works"><span>How it works</span></span></a>
        </div>
      </div>
      <svg viewBox="0 0 300 260" aria-hidden="true" class="lost__map">
        <path class="road" d="M0 60 L300 40 M0 200 L300 182 M70 0 L84 260 M200 0 L214 260" />
        <path class="alt" d="M40 210 C 70 150, 120 120, 160 70" />
        <path class="route" d="M40 210 C 110 220, 190 200, 236 150" />
        <g transform="translate(236 150)" class="x"><path d="M-8 -8 L8 8 M8 -8 L-8 8" /></g>
        <circle cx="40" cy="210" r="8" class="home" /><circle cx="40" cy="210" r="3" class="dot" />
        <circle cx="160" cy="70" r="7" class="stop" />
        <text x="236" y="180" class="why" text-anchor="middle">no such place</text>
        <text x="174" y="66" class="name">the product</text>
        <text x="24" y="240" class="name">you are here</text>
      </svg>
    </div>
  </section>
</Base>
<style>
  .lost { min-height: 78vh; display: grid; align-items: center; padding-block: 4rem; }
  .lost__grid { display: grid; gap: 3rem; align-items: center; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .lost__text { display: grid; gap: 1.4rem; }
  .lost__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 1.3rem; border-radius: 99px; border: 1px solid var(--c-door-line); font-weight: 600; transition: background 0.4s, color 0.4s, border-color 0.4s; }
  .btn:hover { border-color: var(--c-rice); }
  .btn--fill { background: var(--c-turmeric); color: var(--c-door); border-color: var(--c-turmeric); }
  .btn--fill:hover { background: var(--c-rice); border-color: var(--c-rice); }
  .lost__map { width: 100%; overflow: visible; }
  .lost__map .road { stroke: var(--c-rice); stroke-opacity: 0.08; fill: none; }
  .lost__map .route { fill: none; stroke: var(--c-turmeric); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 2 0; }
  .lost__map .alt { fill: none; stroke: var(--c-rice); stroke-opacity: 0.45; stroke-width: 1.5; stroke-dasharray: 3 5; }
  .lost__map .x path { stroke: var(--c-kumkum); stroke-width: 3; stroke-linecap: round; }
  .lost__map .home { fill: none; stroke: var(--c-rice); stroke-width: 1.5; }
  .lost__map .dot { fill: var(--c-rice); }
  .lost__map .stop { fill: var(--c-door); stroke: var(--c-rice); stroke-width: 2; }
  .lost__map text { font: 400 10px var(--f-mono); fill: var(--c-door-muted); }
  .lost__map .why { fill: var(--c-kumkum); }
</style>
